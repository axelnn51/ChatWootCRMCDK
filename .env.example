# ==============================================================================
# Chatwoot Community Edition - Environment Variables Configuration (.env.example)
# Official Documentation: https://www.chatwoot.com/docs/self-hosted/configuration/environment-variables/
# ==============================================================================

# --- Host Port Configuration ---
# Internal Rails runs on 3000. This is the port mapped to the host (127.0.0.1:CHATWOOT_PORT:3000).
CHATWOOT_PORT=3200

# --- Security & Secrets ---
# Generate with 64 hex characters (e.g. `openssl rand -hex 32` or `rake secret`)
SECRET_KEY_BASE=replace_with_secure_64_character_hex_key

# Active Record Encryption keys (Required for MFA / 2FA / sensitive data encryption)
# Generate 32 hex character keys for each:
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=replace_with_secure_32_character_hex_key
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=replace_with_secure_32_character_hex_key
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=replace_with_secure_32_character_hex_key

# --- Application URLs & Domains ---
# The complete public URL where Chatwoot will be accessed (with http:// or https://)
FRONTEND_URL=http://127.0.0.1:3200
# Example for production domain:
# FRONTEND_URL=https://chat.cdkeysperu.com

# Force SSL if running behind HTTPS (Cloudflare or Nginx)
FORCE_SSL=false

# Account Signup settings:
# true: Open public signup
# false: Signups disabled (recommended for self-hosted private use, invite only)
ENABLE_ACCOUNT_SIGNUP=false

# Default locale (en, es, etc.)
DEFAULT_LOCALE=es

# --- PostgreSQL Database ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot_production
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=replace_with_secure_postgres_password
POSTGRES_STATEMENT_TIMEOUT=14s

# --- Redis Configuration ---
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=replace_with_secure_redis_password

# --- Rails & Performance Tuning ---
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
RAILS_MAX_THREADS=5
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
SIDEKIQ_CONCURRENCY=10

# --- Storage ---
# Use 'local' for Docker volume storage. S3 can be configured if needed.
ACTIVE_STORAGE_SERVICE=local
VIPS_BLOCK_UNTRUSTED=1

# --- Email / SMTP Settings ---
# Configura estos campos para que Chatwoot pueda enviar correos de restablecimiento de contraseña e invitaciones.
MAILER_SENDER_EMAIL=Chatwoot <soporte@cdkeysperu.com>
SMTP_DOMAIN=cdkeysperu.com
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# --- Mobile Push Notifications (Official Chatwoot app) ---
ENABLE_PUSH_RELAY_SERVER=true

# --- WhatsApp Cloud API Oficial (Placeholder para fase futura) ---
# Se configurará directamente desde la interfaz de Chatwoot (Canales -> WhatsApp Cloud API).
